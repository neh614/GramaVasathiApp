<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5E6CC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="80dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Host Readiness Checklist"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:paddingBottom="20dp"/>

        <CheckBox
            android:id="@+id/waterCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safe Drinking Water"/>

        <CheckBox
            android:id="@+id/roomCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clean Room"/>

        <CheckBox
            android:id="@+id/toiletCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Western Toilet"/>

        <CheckBox
            android:id="@+id/foodCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Healthy Food"/>

        <Button
            android:id="@+id/calculateBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate Score"
            android:layout_marginTop="25dp"/>

        <TextView
            android:id="@+id/resultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>